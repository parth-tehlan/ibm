{
  "mcpServers": {
    "gaia-acp": {
      "command": "node",
      "args": [
        "../acp-server/court.js"
      ],
      "cwd": ".",
      "env": {},
      "alwaysAllow": [
        "witness_verdict_all",
        "witness_clause",
        "trustgap_report",
        "trustgap_mutants",
        "triage_context",
        "triage_run",
        "triage_postmortem",
        "courts_about"
      ],
      "disabled": false
    },
    "gauntlet-signals": {
      "command": "node",
      "args": [
        ".bob/mcp/gauntlet.js"
      ],
      "cwd": ".",
      "env": {},
      "alwaysAllow": [
        "list_clauses",
        "get_test_status",
        "submit_waiver",
        "get_trust_gap",
        "get_logs",
        "get_metrics",
        "get_recent_deploys",
        "get_mutants"
      ],
      "disabled": false
    },
    "gaia-courts": {
      "command": "node",
      "args": [
        "/home/ubuntu/ibm-bob/court-extension/court.js",
        "--repo",
        "/home/ubuntu/ibm-bob/northstar"
      ],
      "alwaysAllow": [
        "witness_clauses",
        "witness_verdict_all",
        "witness_clause",
        "trustgap_report",
        "trustgap_mutants",
        "trustgap_mutate",
        "trustgap_status",
        "triage_context",
        "triage_run",
        "triage_postmortem",
        "courts_about"
      ],
      "disabled": false
    }
  }
}