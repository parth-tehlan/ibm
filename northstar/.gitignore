# =============================================================
# northstar (.gitignore)
# TRIUMPH sample payments microservice monorepo (node/ts + jest)
# =============================================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Build artifacts ----
dist/
build/
out/
*.tsbuildinfo
*.js.map
*.d.ts.map

# ---- Testing / code quality ----
coverage/
.nyc_output/
.mutationtesting/
stryker-tmp/
.stryker-tmp/
.reports/
reports/

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.csr

# ---- Local state fixtures that must not be committed ----
# NOTE: secrets/ inside fixtures is defense-in-depth; do NOT track secrets.
fixtures/secrets/
fixtures/tmp/
fixtures/*.json
!fixtures/logs.json
!fixtures/metrics.json
!fixtures/deploy.json
!fixtures/mutants.json

# ---- MTTR measurement in-progress marker (scripts/mttr.mjs) ----
incident/.start_epoch

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ---- Editor / OS ----
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---- Misc temp / cache ----
.cache/
.tmp/
*.tmp
*.temp
*.orig
*~
# TRIUMPH in-loop verify workspace (lib/verify.js tmp mirrors, TTL-swept)
.triumph/tmp/
