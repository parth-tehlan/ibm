# Ship the engine, libs, agents, schemas, extension host, CLIs, and the
# packaged dashboard (server + contracts + built dist + its production deps).
# Exclude dev/test + CI surface.
tests/
node_modules/
.github/
*.vsix
*.map
.gitignore
package-lock.json

# Keep the dashboard's pinned production runtime dependencies (express, zod);
# exclude only non-dashboard node_modules.
!dashboard/node_modules/**
dashboard/**/*.map

