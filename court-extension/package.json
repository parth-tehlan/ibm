{
"name": "gaia-courts",
  "displayName": "Gaia 3-Court Dev Tool",
  "description": "WITNESS / TRUSTGAP / TRIAGE courts for any repo and any model — spec-witness tests, honest coverage, incident forensics. Path-1: installs court subagents into the agent hosts you already have; never calls a model itself.",
  "version": "0.2.5",
  "publisher": "gaia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parth-tehlan/ibm.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Testing",
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "mcp",
    "testing",
    "mutation-testing",
    "spec",
    "postmortem",
    "agents"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gaia.installCourts",
        "title": "Gaia: Install courts for this repo",
        "category": "Gaia"
      },
      {
        "command": "gaia.detectConfig",
        "title": "Gaia: Auto-detect .gaia.yml",
        "category": "Gaia"
      },
      {
        "command": "gaia.runCourt",
        "title": "Gaia: Run a court (WITNESS/TRUSTGAP/TRIAGE)",
        "category": "Gaia"
      },
      {
        "command": "gaia.generateReport",
        "title": "Gaia: Generate 3-court report (HTML + MD)",
        "category": "Gaia"
      },
      {
        "command": "gaia.openReport",
        "title": "Gaia: Open last report",
        "category": "Gaia"
      },
      {
        "command": "gaia.dashboardRun",
        "title": "Gaia: Run courts and publish to dashboard",
        "category": "Gaia"
      },
      {
        "command": "gaia.statusBarAction",
        "title": "Gaia: Status bar quick-action menu",
        "category": "Gaia"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gaia.installCourts"
        },
        {
          "command": "gaia.detectConfig"
        },
        {
          "command": "gaia.runCourt"
        },
        {
          "command": "gaia.generateReport"
        },
        {
          "command": "gaia.openReport"
        },
        {
          "command": "gaia.dashboardRun"
        }
      ],
      "statusBar/windowIndicator": [
        {
          "command": "gaia.statusBarAction",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gaia",
          "title": "Gaia",
          "icon": "media/gaia.svg"
        }
      ]
    },
    "views": {
      "gaia": [
        {
          "type": "webview",
          "id": "gaia.panel",
          "name": "3-Court"
        }
      ]
    },
    "configuration": {
      "title": "Gaia 3-Court",
      "properties": {
        "gaia.defaultHost": {
          "type": "string",
          "enum": [
            "vscode",
            "claude",
            "bob",
            "codex",
            "generic",
            "all"
          ],
          "default": "all",
          "description": "Agent host(s) the 'Install courts' command targets."
        },
        "gaia.enginePath": {
          "type": "string",
          "default": "",
          "description": "Override path to court.js (defaults to the bundled engine)."
        }
      }
    }
  },
  "scripts": {
    "setup": "node bin/gaia-setup.js",
    "report": "node bin/gaia-report.js",
    "stage:dashboard": "node bin/stage-dashboard.js",
"test": "node tests/runners-safety.js && node tests/webstorage-flag-safety.js && node tests/mutation-safety.js && node tests/toolenv.js && node tests/run.js && node tests/properties.js && node tests/hosts-safety.js && node tests/wall-strength.js && node tests/extension.js && node tests/run-summary.js && node tests/run-coordinator.js && node tests/panel.js && node tests/panel-ui.js && node tests/dashboard.js && node tests/dashboard-integration.js && node tests/mcp-client.js && node tests/validator-parity.js && node tests/diff.js && node tests/micro.js && node tests/verify-diff.js",
    "test:live": "node tests/properties-live.js",
    "test:packaged:bob": "node ../scripts/verify-packaged-bob.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "jsdom": "^26.1.0"
  }
}
